{
  "name": "ai-crm",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant AI CRM SaaS (product name is a placeholder — see packages/shared/src/brand.ts)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev:dashboard": "pnpm --filter @ai-crm/dashboard dev",
    "dev:widget": "pnpm --filter @ai-crm/widget dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:test:local": "scripts/db/test-local.sh",
    "db:remote:status": "node scripts/db/supabase-remote.mjs status",
    "db:remote:migrate": "node scripts/db/supabase-remote.mjs migrate",
    "db:remote:test": "node scripts/db/supabase-remote.mjs test",
    "db:types:remote": "node scripts/db/supabase-remote.mjs types && prettier --write packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
