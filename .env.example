# =============================================================================
# Environment variables — EXAMPLE ONLY. No real values. Copy to .env.local (gitignored).
#
# Two kinds:
#   VITE_*  → bundled into the browser (dashboard/widget). PUBLIC values only.
#   others  → server-side only: Supabase Edge Function secrets (`supabase secrets set`)
#             or local `supabase/functions/.env`. Never expose to the browser.
# Supabase key naming (publishable/secret vs anon/service_role) — needs verification for the
# new project; both are listed.
# =============================================================================

# ---- App ---------------------------------------------------------------------
VITE_APP_ENV=local                      # local | staging | production
APP_BASE_URL=http://localhost:5173      # dashboard origin (used in emails, PayPal return URLs)

# ---- Supabase (browser-safe) ---------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
VITE_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api
VITE_WIDGET_CDN_URL=http://localhost:5174
VITE_WIDGET_API_URL=http://127.0.0.1:54321/functions/v1/widget

# ---- Supabase (server-only) ----------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-or-service-role-key
SUPABASE_PROJECT_REF=replace-with-project-ref          # EU (Frankfurt) project

# ---- Internal ------------------------------------------------------------------
WORKER_SECRET=replace-with-long-random-string          # header for worker invocations
WIDGET_VISITOR_TOKEN_PEPPER=replace-with-long-random-string

# ---- AI: generation (Anthropic) ------------------------------------------------
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Defaults only; per-plan model profiles live in the ai_model_profiles table.
AI_DEFAULT_MODEL_PROFILE=standard

# ---- AI: embeddings (Voyage AI) ------------------------------------------------
VOYAGE_API_KEY=replace-with-voyage-key
EMBEDDINGS_MODEL=voyage-multilingual-2                 # needs verification (P10); 1024 dims
EMBEDDINGS_DIMENSIONS=1024

# ---- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=no-reply@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ---- Payments (PayPal) ---------------------------------------------------------
PAYPAL_ENV=sandbox                                      # sandbox | live
VITE_PAYPAL_CLIENT_ID=replace-with-paypal-client-id     # public client id (browser-safe)
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id

# ---- Meta (WhatsApp / Messenger / Instagram) -----------------------------------
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret            # webhook signature verification
META_WEBHOOK_VERIFY_TOKEN=replace-with-long-random-string
META_GRAPH_API_VERSION=vXX.X                            # pin explicitly — needs verification
# Per-channel access tokens are NOT env vars: they are stored in Supabase Vault per connection.

# ---- n8n (side automations only) -----------------------------------------------
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/replace-me
N8N_WEBHOOK_SECRET=replace-with-long-random-string      # HMAC-SHA256 signature of payloads

# ---- Cloudflare (deployment — later phase) ---------------------------------------
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-scoped-token
