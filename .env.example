# =============================================================================
# Environment variables — EXAMPLE ONLY. No real values. Copy to .env.local (gitignored).
#
# Names follow MASTER_PROMPT §21 (decision E12). Two kinds:
#   VITE_*  → bundled into the browser (dashboard/widget). PUBLIC values only. Vite exposes only
#             VITE_* variables, so a browser copy of a §21 value keeps the VITE_ prefix.
#   others  → server-side only: Supabase Edge Function secrets (`supabase secrets set`) or local
#             `supabase/functions/.env`. Never expose to the browser.
# =============================================================================

# ---- App ---------------------------------------------------------------------
VITE_APP_ENV=local                      # local | staging | production
APP_URL=http://localhost:5173           # dashboard origin (emails, PayPal return URLs)

# ---- Supabase ------------------------------------------------------------------
# SUPABASE_ANON_KEY holds the browser-safe key: use the publishable key (sb_publishable_…).
# SUPABASE_SERVICE_ROLE_KEY holds a secret key (sb_secret_…). Legacy anon / service_role JWTs still
# work but Supabase deprecates them in early 2027 (verified 2026-11-26, docs/SECURITY.md §6).
# New keys go in the `apikey` header, not `Authorization: Bearer`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-or-service-role-key   # server only
SUPABASE_PROJECT_REF=replace-with-project-ref                       # prod: EU (Frankfurt) project
# Developer/ops only — Management API runner (scripts/db/supabase-remote.mjs). Never in functions
# or the browser.
SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token-sbp
# Browser copies
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
VITE_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api

# ---- Auth: Google sign-in (P3, optional — decision E8) ---------------------------
# Off unless configured. Local stack: [auth.external.google] in supabase/config.toml with
# secret = "env(SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET)" (name from the Supabase Google guide,
# checked 2026-11-26). Local redirect URI: http://127.0.0.1:54321/auth/v1/callback.
VITE_AUTH_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ---- Widget --------------------------------------------------------------------
WIDGET_CDN_URL=http://localhost:5174                 # versioned widget.js host
WIDGET_SIGNING_SECRET=replace-with-long-random-string  # HMAC key for short-lived widget session tokens
# Browser copies
VITE_WIDGET_CDN_URL=http://localhost:5174            # dashboard renders the install snippet
VITE_WIDGET_API_URL=http://127.0.0.1:54321/functions/v1/widget-gateway

# ---- Internal ------------------------------------------------------------------
WORKER_SECRET=replace-with-long-random-string        # header for ai-worker / kb-ingest / scheduler calls

# ---- AI: generation (Anthropic) ------------------------------------------------
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Defaults only; per-plan model profiles live in the ai_model_profiles table.
AI_DEFAULT_MODEL_PROFILE=standard

# ---- AI: embeddings (Voyage AI) ------------------------------------------------
VOYAGE_API_KEY=replace-with-voyage-key
EMBEDDINGS_MODEL=voyage-multilingual-2               # needs verification (proposal P10); 1024 dims
EMBEDDINGS_DIMENSIONS=1024

# ---- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=no-reply@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ---- Payments (PayPal) ---------------------------------------------------------
PAYPAL_ENV=sandbox                                   # sandbox | live
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
VITE_PAYPAL_CLIENT_ID=replace-with-paypal-client-id  # public client id (browser copy)

# ---- Meta (WhatsApp / Messenger / Instagram) -----------------------------------
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret         # webhook signature verification
META_VERIFY_TOKEN=replace-with-long-random-string    # webhook GET verification (hub.verify_token)
# Embedded Signup v4 config id; used only when the meta_embedded_signup flag is on — needs verification
META_CONFIG_ID=replace-with-embedded-signup-config-id
META_GRAPH_API_VERSION=vXX.X                         # pin explicitly — needs verification
# Per-channel access tokens are NOT env vars: they are stored in Supabase Vault per channel.

# ---- n8n (side automations only) -----------------------------------------------
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/replace-me
N8N_SHARED_SECRET=replace-with-long-random-string    # HMAC-SHA256 signature of payloads

# ---- Cloudflare (deployment — P17) ---------------------------------------------
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-scoped-token
